            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "DB 블록당 읽기 지연 (µs)",
      "description": "버퍼 밖 블록 하나를 읽는 평균 시간. 부하 시험에서 9 µs 이하면 통과, 14 µs 이상이면 흔들렸다. DB에 track_io_timing이 켜져 있어야 값이 나온다(부하 overlay는 켠다).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "µs",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * rate(pg_stat_database_blk_read_time{datname=\"baton\"}[1m]) / rate(pg_stat_database_blks_read{datname=\"baton\"}[1m])",
          "legendFormat": "µs/블록",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
